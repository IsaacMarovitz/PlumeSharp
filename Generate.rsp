--config
vtbls=trimmable
types=unix
file=multi
codegen=latest
--generate
empty-records=false
enum-operators=false
funcs-with-body=true
helper-types
aggressive-inlining
disable-runtime-marshalling
tests-nunit
native-inheritance-attribute
generic-pointer-wrapper
vtbl-index-attribute
--exclude
# Raytracing API contains std containers
# and is also not needed for our purposes
RenderTopLevelASBuildInfo
RenderTopLevelASInstance
RenderBottomLevelASBuildInfo
RenderBottomLevelASMesh
RenderAccelerationStructure
RenderAccelerationStructureDesc
RenderAccelerationStructureType
RenderRaytracingPipelineDesc
RenderRaytracingPipelineHitGroup
RenderRaytracingPipelineLibrary
RenderRaytracingPipelineLibrarySymbol
RenderRaytracingPipelineLibrarySymbolType
RenderShaderBindingTableInfo
RenderShaderBindingGroupsInfo
RenderShaderBindingGroupInfo
RenderShaderBindingGroups
RenderShaderBindingGroup
setAccelerationStructure
createRaytracingPipelineRaw
createAccelerationStructureRaw
setBottomLevelASBuildInfo
setTopLevelASBuildInfo
setShaderBindingTableInfo
buildBottomLevelAS
buildTopLevelAS
traceRays
--remap-type
RenderBufferFlag::Bits=RenderBufferFlag
--log
exclusions
potential-typedef-remappings
--language
c++
--file
./sources/plume/plume_render_interface.h
./sources/plume/plume_render_interface_types.h
--namespace
Plume
--library-path
native/libplume.a
--output
./PlumeSharp/
--test-output
./PlumeSharp.UnitTests/
